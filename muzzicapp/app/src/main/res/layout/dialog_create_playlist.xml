<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="28dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#4DFFFFFF" />

    <!-- Title & Close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="18dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tạo Playlist Mới"
            android:textColor="@color/text_primary_adaptive"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/create_playlist_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            app:tint="@color/text_tertiary_adaptive" />
    </LinearLayout>

    <!-- Cover Preview Section with Auto-generator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_rounded_card"
        android:padding="14dp"
        android:layout_marginBottom="16dp">

        <!-- Cover Preview Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="88dp"
            android:layout_height="88dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@android:color/transparent">

            <ImageView
                android:id="@+id/create_playlist_cover_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_gradient_suggest1" />

            <ImageView
                android:id="@+id/create_playlist_cover_watermark"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_bookmark"
                app:tint="#80FFFFFF" />
        </androidx.cardview.widget.CardView>

        <!-- Auto-generate Options -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ảnh bìa nghệ thuật"
                android:textColor="@color/text_primary_adaptive"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/create_playlist_cover_style_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phong cách: Sunset Violet"
                android:textColor="@color/text_secondary_adaptive"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp" />

            <!-- Button: Change Cover Art -->
            <TextView
                android:id="@+id/create_playlist_btn_cycle_cover"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Đổi ảnh bìa tự động"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_chip_sync"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Playlist Name Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tên danh sách phát"
        android:textColor="@color/text_secondary_adaptive"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/create_playlist_input_name"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Ví dụ: Nhạc Chill Đêm, Nhạc Tập Gym..."
        android:textColor="@color/text_primary_adaptive"
        android:textColorHint="@color/text_tertiary_adaptive"
        android:textSize="15sp"
        android:singleLine="true"
        android:background="@drawable/bg_rounded_card"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:layout_marginBottom="12dp" />

    <!-- Quick Preset Tag Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_preset_chill"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="Nhạc Chill"
                android:textColor="@color/text_primary_adaptive"
                android:textSize="12sp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/bg_chip_light"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_preset_energy"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="Năng Lượng"
                android:textColor="@color/text_primary_adaptive"
                android:textSize="12sp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/bg_chip_light"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_preset_night"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="Đêm Muộn"
                android:textColor="@color/text_primary_adaptive"
                android:textSize="12sp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/bg_chip_light"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_preset_coffee"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="Cà Phê"
                android:textColor="@color/text_primary_adaptive"
                android:textSize="12sp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/bg_chip_light"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_preset_fav"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="Yêu Thích"
                android:textColor="@color/text_primary_adaptive"
                android:textSize="12sp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/bg_chip_light"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/create_playlist_btn_cancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Hủy"
            android:textColor="@color/text_secondary_adaptive"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_chip_light"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/create_playlist_btn_submit"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.6"
            android:text="Tạo Playlist"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_chip_sync"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
