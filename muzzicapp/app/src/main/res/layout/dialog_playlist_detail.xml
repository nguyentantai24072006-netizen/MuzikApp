<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#4DFFFFFF" />

    <!-- Playlist Header Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <androidx.cardview.widget.CardView
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@android:color/transparent">

            <ImageView
                android:id="@+id/playlist_detail_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_gradient_suggest1" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/playlist_detail_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên Playlist"
                android:textColor="@color/text_primary_adaptive"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/playlist_detail_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 bài hát"
                android:textColor="@color/text_secondary_adaptive"
                android:textSize="13sp"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- Close Dialog Button -->
        <ImageView
            android:id="@+id/playlist_detail_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            app:tint="@color/text_tertiary_adaptive" />
    </LinearLayout>

    <!-- Quick Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <!-- Play All -->
        <TextView
            android:id="@+id/playlist_detail_btn_play_all"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.2"
            android:text="▶ Phát tất cả"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_chip_sync"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp" />

        <!-- Auto Change Cover Art -->
        <TextView
            android:id="@+id/playlist_detail_btn_change_cover"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Đổi ảnh bìa"
            android:textColor="@color/text_primary_adaptive"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_chip_light"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp" />

        <!-- Delete Playlist -->
        <LinearLayout
            android:id="@+id/playlist_detail_btn_delete_container"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_chip_light"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_delete"
                app:tint="#FF5252"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/playlist_detail_btn_delete_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xóa playlist"
                android:textColor="#FF5252"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_adaptive" />

    <!-- Tracks List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/playlist_detail_recycler"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="12dp" />

    <!-- Empty View -->
    <LinearLayout
        android:id="@+id/playlist_detail_empty"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_bookmark"
            app:tint="@color/text_tertiary_adaptive"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chưa có bài hát nào trong playlist này"
            android:textColor="@color/text_primary_adaptive"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hãy chạm biểu tượng lưu khi đang nghe nhạc để thêm vào đây."
            android:textColor="@color/text_secondary_adaptive"
            android:textSize="12sp"
            android:gravity="center" />
    </LinearLayout>
</LinearLayout>
