<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trending_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="9dp"
    android:paddingBottom="9dp"
    android:layout_marginBottom="2dp"
    android:background="@drawable/bg_track_row_idle"
    android:clickable="true"
    android:focusable="true">

    <!-- Rank Number with rank badge styling -->
    <TextView
        android:id="@+id/trending_rank"
        android:layout_width="26dp"
        android:layout_height="wrap_content"
        android:text="1"
        android:textColor="@color/text_primary_adaptive"
        android:textSize="15sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- Thumbnail wrapped in CardView with 10dp rounded corners -->
    <androidx.cardview.widget.CardView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent">

        <ImageView
            android:id="@+id/trending_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_song_thumb" />
    </androidx.cardview.widget.CardView>

    <!-- Song Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/trending_playing_indicator"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_sound_wave"
                android:visibility="gone"
                android:layout_marginEnd="5dp" />

            <TextView
                android:id="@+id/trending_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Song Title"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <!-- High Quality Audio Tag -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HQ"
                android:textColor="#38BDF8"
                android:textSize="9sp"
                android:textStyle="bold"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:background="@drawable/bg_badge_hq" />

            <TextView
                android:id="@+id/trending_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Artist"
                android:textColor="@color/text_secondary_adaptive"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Play Action Button -->
    <FrameLayout
        android:id="@+id/trending_play_btn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/trending_play_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:layout_marginStart="1.5dp"
            android:src="@drawable/ic_play"
            app:tint="@color/white" />
    </FrameLayout>

    <!-- More Options Button (Three dots) -->
    <ImageView
        android:id="@+id/trending_btn_more"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_more"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:padding="6dp"
        app:tint="@color/text_secondary_adaptive"
        android:layout_marginStart="2dp" />
</LinearLayout>
