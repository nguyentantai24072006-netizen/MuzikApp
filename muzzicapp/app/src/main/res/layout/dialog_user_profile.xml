<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Pill handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:background="#4DFFFFFF" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thông Tin Tài Khoản"
            android:textColor="@color/text_primary_adaptive"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/profile_btn_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/text_tertiary_adaptive" />
    </RelativeLayout>

    <!-- User Info Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_search_bar"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/profile_avatar_text"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="U"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/coral_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/profile_tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên Người Dùng"
                android:textColor="@color/text_primary_adaptive"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/profile_tv_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="user@gmail.com"
                android:textColor="@color/text_secondary_adaptive"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/profile_tv_sync_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã đồng bộ với Firebase Cloud"
                android:textColor="#34C759"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Sync Now Button -->
    <TextView
        android:id="@+id/profile_btn_sync_now"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="Đồng bộ dữ liệu ngay bây giờ"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/bg_chip_sync"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="10dp" />

    <!-- Sign Out Button -->
    <TextView
        android:id="@+id/profile_btn_sign_out"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="Đăng xuất"
        android:textColor="@color/text_primary_adaptive"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/bg_chip_dark"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="8dp" />

    <!-- Delete Account Button -->
    <TextView
        android:id="@+id/profile_btn_delete_account"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Xóa tài khoản vĩnh viễn"
        android:textColor="#FF453A"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
