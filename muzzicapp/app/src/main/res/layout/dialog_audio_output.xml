<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:paddingBottom="26dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_pill_handle" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/dialog_audio_header_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_volume_up"
            android:layout_marginEnd="10dp"
            app:tint="@color/coral_primary" />

        <TextView
            android:id="@+id/dialog_audio_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Âm lượng &amp; Đầu ra âm thanh"
            android:textColor="@color/text_primary_adaptive"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/dialog_audio_btn_close"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            app:tint="@color/text_secondary_adaptive"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Volume Control Section Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_audio_card"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <!-- Volume Label & Percentage -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MỨC ÂM LƯỢNG"
                android:textColor="@color/text_tertiary_adaptive"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:id="@+id/dialog_audio_tv_volume_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="70%"
                android:textColor="@color/coral_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Mute Button & Seekbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <ImageView
                android:id="@+id/dialog_audio_btn_mute"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_volume_up"
                android:padding="3dp"
                app:tint="@color/coral_primary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <SeekBar
                android:id="@+id/dialog_audio_volume_seekbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:progressTint="@color/coral_primary"
                android:progressBackgroundTint="#26FFFFFF"
                android:thumbTint="@color/coral_primary"
                android:splitTrack="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- Audio Output Selection Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="THIẾT BỊ PHÁT ÂM THANH"
        android:textColor="@color/text_tertiary_adaptive"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:layout_marginStart="22dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp">

        <!-- Speaker Item -->
        <LinearLayout
            android:id="@+id/dialog_audio_item_speaker"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_audio_card_active"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="8dp">

            <FrameLayout
                android:id="@+id/dialog_audio_box_speaker"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_audio_icon_box_active"
                android:layout_marginEnd="14dp">

                <ImageView
                    android:id="@+id/dialog_audio_icon_speaker"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_speaker"
                    app:tint="@color/coral_primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dialog_audio_tv_speaker_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loa ngoài điện thoại"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dialog_audio_tv_speaker_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đang phát âm thanh"
                    android:textColor="@color/coral_light"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/dialog_audio_check_speaker"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_check"
                app:tint="@color/coral_primary"
                android:visibility="visible" />
        </LinearLayout>

        <!-- Headset Item (Visible only when headphones / bluetooth are connected) -->
        <LinearLayout
            android:id="@+id/dialog_audio_item_headset"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_audio_card"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:layout_marginBottom="8dp">

            <FrameLayout
                android:id="@+id/dialog_audio_box_headset"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_audio_icon_box_inactive"
                android:layout_marginEnd="14dp">

                <ImageView
                    android:id="@+id/dialog_audio_icon_headset"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_headset"
                    app:tint="@color/text_secondary_adaptive" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dialog_audio_tv_headset_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tai nghe"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/dialog_audio_tv_headset_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đã kết nối"
                    android:textColor="@color/text_tertiary_adaptive"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/dialog_audio_check_headset"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_check"
                app:tint="@color/coral_primary"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
