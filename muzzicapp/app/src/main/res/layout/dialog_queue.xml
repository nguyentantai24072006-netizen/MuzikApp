<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="540dp"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="#4DFFFFFF" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/dialog_queue_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Danh sách phát tiếp theo"
            android:textColor="@color/text_primary_adaptive"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialog_queue_clear"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="Xoá tất cả"
            android:textColor="#FF5252"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_chip_sync"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="12dp" />

        <ImageView
            android:id="@+id/dialog_queue_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            app:tint="@color/text_tertiary_adaptive" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_adaptive" />

    <!-- Queue List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dialog_queue_recycler"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/dialog_queue_empty"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:gravity="center"
        android:text="Hàng chờ đang trống\nChọn một bài hát để bắt đầu"
        android:textColor="@color/text_secondary_adaptive"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
